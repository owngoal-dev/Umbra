    "This app is tweaked by Bootstrap, please disable tweak for it in the AppList of Bootstrap first.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تفعيل التعديلات لهذا التطبيق عبر Bootstrap. عطّلها أولًا في AppList ضمن Bootstrap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese App sind Tweaks über Bootstrap aktiviert. Deaktivieren Sie sie zuerst in der AppList von Bootstrap."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tweaks are enabled for this app through Bootstrap. Disable them in Bootstrap’s AppList first."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des tweaks sont activés pour cette application via Bootstrap. Désactivez-les d’abord dans l’AppList de Bootstrap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bootstrap ha attivato i tweak per questa app. Disattivali prima nell’AppList di Bootstrap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bootstrap でこのアプリの Tweak が有効になっています。先に Bootstrap の AppList で無効にしてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bootstrap đang bật tweak cho ứng dụng này. Hãy tắt trước trong AppList của Bootstrap."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bootstrap 已为此应用启用插件注入。请先在 Bootstrap 的 AppList 中将其关闭。"
          }
        }
      }
    },
    "This permanently removes this app’s data. This cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف بيانات هذا التطبيق نهائيًا. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten dieser App werden dauerhaft gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes this app’s data. This cannot be undone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de cette application seront supprimées définitivement. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati di questa app verranno eliminati definitivamente. L’operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリのデータを完全に削除します。この操作は取り消せません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu của ứng dụng này sẽ bị xóa vĩnh viễn. Không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

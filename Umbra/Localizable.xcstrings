    "SSH Server has been installed, you can uninstall it via Sileo/Zebra.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم اكتشاف خادم SSH. يمكنك إلغاء تثبيته عبر Sileo أو تغيير المنفذ الافتراضي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein SSH-Server wurde erkannt. Sie können ihn über Sileo deinstallieren oder den Standardport ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An SSH server was detected. You can uninstall it using Sileo or change the default port."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un serveur SSH a été détecté. Vous pouvez le désinstaller via Sileo ou modifier le port par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stato rilevato un server SSH. Puoi disinstallarlo tramite Sileo o modificare la porta predefinita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH サーバーが検出されました。Sileo からアンインストールするか、デフォルトのポートを変更できます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã phát hiện máy chủ SSH. Bạn có thể gỡ cài đặt qua Sileo hoặc thay đổi cổng mặc định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已检测到 SSH 服务，可通过 Sileo 卸载，或修改默认端口。"
          }
        }
      }
    },

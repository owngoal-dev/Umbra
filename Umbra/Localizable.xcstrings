    "Replace only the App scheme. Paths and parameters stay unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستبدل مخطط التطبيق فقط. تبقى المسارات والمعلمات كما هي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur das App-Schema wird ersetzt. Pfade und Parameter bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace only the App scheme. Paths and parameters stay unchanged."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le schéma de l’app est remplacé. Les chemins et paramètres sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene sostituito solo lo schema dell’app. Percorsi e parametri restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App のスキームのみを置換します。パスとパラメータは変更しません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ thay Scheme của ứng dụng. Giữ nguyên đường dẫn và tham số."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅替换 App 的 Scheme，保留路径和参数。"
          }
        }
      }
    },

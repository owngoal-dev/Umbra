    "Saving restarts active services. Use the new ports to reconnect.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي الحفظ إلى إعادة تشغيل الخدمات المفعّلة. استخدم المنافذ الجديدة لإعادة الاتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Sichern werden aktive Dienste neu gestartet. Verbinde dich anschließend über die neuen Ports."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving restarts active services. Use the new ports to reconnect."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement redémarre les services actifs. Utilisez les nouveaux ports pour vous reconnecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il salvataggio riavvia i servizi attivi. Usa le nuove porte per riconnetterti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存すると有効なサービスが再起動します。再接続には新しいポートを使用してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu sẽ khởi động lại các dịch vụ đang bật. Dùng cổng mới để kết nối lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存后会重启已启用的服务。重新连接时请使用新端口。"
          }
        }
      }
    },

    "Some apps may refuse to run because a VPN/Proxy is enabled.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تفعيل VPN أو وكيل. قد ترفض بعض التطبيقات العمل بسبب ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein VPN oder Proxy ist aktiviert. Einige Apps lassen sich deshalb möglicherweise nicht ausführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A VPN or proxy is enabled. Some apps may refuse to run."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un VPN ou un proxy est activé. Certaines applications peuvent refuser de fonctionner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È attivo un VPN o un proxy. Alcune app potrebbero rifiutarsi di funzionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN またはプロキシが有効になっています。一部のアプリが動作を拒否する場合があります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN hoặc proxy đang được bật. Một số ứng dụng có thể từ chối hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前已启用 VPN 或代理，部分应用可能因此拒绝运行。"
          }
        }
      }
    },

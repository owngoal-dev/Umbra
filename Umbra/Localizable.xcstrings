    "*WARNING*: Don't touch any other files in /private/preboot/, otherwise it will cause bootloop": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحذير: لا تعدّل أي ملفات أخرى في ‎/private/preboot/‎، لأن ذلك سيؤدي إلى حلقة إعادة تشغيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warnung: Ändern Sie keine anderen Dateien in /private/preboot/. Dies führt zu einer Startschleife."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warning: Do not modify any other files in /private/preboot/. Doing so will cause a boot loop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avertissement : ne modifiez aucun autre fichier dans /private/preboot/, sous peine de provoquer une boucle de redémarrage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attenzione: non modificare altri file in /private/preboot/, altrimenti il dispositivo entrerà in un ciclo di riavvii."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "警告：/private/preboot/ 内の他のファイルを変更しないでください。変更すると起動ループが発生します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảnh báo: Không sửa đổi bất kỳ tệp nào khác trong /private/preboot/, nếu không thiết bị sẽ bị khởi động lại liên tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "警告：请勿修改 /private/preboot/ 中的其他文件，否则会导致设备循环重启。"
          }
        }
      }
    },
